# Copy to .env for local development. On Vercel add these under
# Project -> Settings -> Environment Variables.
#
# The contact form (src/pages/api/contact.ts) sends email over SMTP using the
# mailbox you bought with the domain. Ask your email host for the SMTP details.

SMTP_HOST=mail.reliancetrading.co.za
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@reliancetrading.co.za
SMTP_PASS=change-me

# Where enquiries are delivered (defaults to the site email if blank)
CONTACT_TO=info@reliancetrading.co.za
# The "From" address - most SMTP hosts require this to match SMTP_USER
CONTACT_FROM=info@reliancetrading.co.za

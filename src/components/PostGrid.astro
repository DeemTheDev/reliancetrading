---
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
import { categories, type CategorySlug } from '../data/categories';
interface Props { posts: CollectionEntry<'blog'>[]; emptyText?: string }
const { posts, emptyText = 'No articles have been published yet.' } = Astro.props;
const fmt = (d: Date) => new Intl.DateTimeFormat('en-ZA', { day: 'numeric', month: 'long', year: 'numeric' }).format(d);
---
<div class="blog-layout">
  <div>
    {posts.length === 0 && <p>{emptyText}</p>}
    <div class="post-grid">
      {posts.map((p, i) => (
        <article class="post-card" data-reveal style={`--reveal-delay:${(i % 2) * 120}ms`}>
          <a href={`/blog/${p.id}/`}><img src={p.data.image} alt="" loading="lazy" /></a>
          <div class="post-card-body">
            <div class="post-meta">{fmt(p.data.pubDate)} &middot; {categories[p.data.category as CategorySlug]}</div>
            <h3><a href={`/blog/${p.id}/`}>{p.data.title}</a></h3>
            <p>{p.data.description}</p>
            <a href={`/blog/${p.id}/`} class="small" style="font-weight:700">Read more <Icon name="arrow-right" size={14} /></a>
          </div>
        </article>
      ))}
    </div>
  </div>
  <aside class="blog-aside">
    <h3>Categories</h3>
    <ul>
      {Object.entries(categories).map(([slug, name]) => (
        <li><a href={`/blog/category/${slug}/`}>{name}</a></li>
      ))}
    </ul>
  </aside>
</div>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import { site } from '../config/site';
import { faqs } from '../data/faqs';

// The original lays the first ten questions out in two columns and the longer
// company / developer questions full-width underneath.
const twoCol = faqs.slice(0, 10);
const colA = twoCol.filter((_, i) => i % 2 === 0);
const colB = twoCol.filter((_, i) => i % 2 === 1);
const rest = faqs.slice(10);
---
<BaseLayout title="FAQs" description={`Frequently asked questions about bridging finance from ${site.name}.`}>
  <PageHero title="FAQs" subtitle="Frequently asked questions" image="/images/hero-faqs.svg" />

  <section class="faq-section">
    <div class="container">
      <h2 data-reveal>Frequently asked questions</h2>
      <div class="faq-columns">
        <div data-reveal style="--reveal-delay:100ms">
          {colA.map((f) => (
            <details class="faq">
              <summary>{f.q} <Icon name="chevron-down" /></summary>
              <div class="faq-answer">{f.a}</div>
            </details>
          ))}
        </div>
        <div data-reveal style="--reveal-delay:220ms">
          {colB.map((f) => (
            <details class="faq">
              <summary>{f.q} <Icon name="chevron-down" /></summary>
              <div class="faq-answer">{f.a}</div>
            </details>
          ))}
        </div>
      </div>
      <div style="margin-top:40px" data-reveal>
        {rest.map((f) => (
          <details class="faq">
            <summary>{f.q} <Icon name="chevron-down" /></summary>
            <div class="faq-answer">{f.a}</div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="cta-band">
    <div class="container">
      <h2>Still have a question?</h2>
      <a class="btn btn-white" href="/contact-us/">Contact us</a>
    </div>
  </section>
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { site } from '../config/site';
import { products } from '../data/products';
import { testimonials, showTestimonials } from '../data/testimonials';

const focus = products.filter((p) => p.focus);
const regionsText = site.regions.join(', ').replace(/, ([^,]*)$/, ' and $1');
const CO = site.name.toUpperCase();
---
<BaseLayout title={site.name}>
  <!-- Hero (background layer drifts with a parallax effect) -->
  <section class="hero">
    <div class="parallax-bg" data-parallax="0.3" style="background-image:url('/images/hero-home.svg')"></div>
    <div class="container">
      <div class="hero-content">
        <p class="hero-phone"><a href={site.phoneHref} style="color:inherit">{site.phone}</a></p>
        <p class="hero-tagline">{site.tagline}</p>
        <h1>Easy, efficient, fast</h1>
        <p>{site.heroIntro}</p>
        <a class="btn btn-brand" href="#learn-more">Know more</a>
      </div>
    </div>
  </section>

  <!-- Two feature cards over a slow-moving light texture -->
  <section class="features" id="learn-more">
    <div class="parallax-bg" data-parallax="0.15" style="background-image:url('/images/texture-light.svg')"></div>
    <div class="container">
      <div class="feature-card feature-card--right" data-reveal="right">
        <div class="feature-head">
          <h3>We operate nationally</h3>
          <img src="/images/feature-national.svg" alt="" width="92" height="92" />
        </div>
        <p>
          Operating nationally throughout South Africa from its head office in {site.headOffice}, {CO} has regional
          representation in {regionsText}.
        </p>
        <a class="btn btn-brand btn-sm" href="/about/">Learn more</a>
      </div>

      <div class="feature-card" data-reveal="left">
        <div class="feature-head">
          <h3>Our primary focus</h3>
          <img src="/images/feature-focus.svg" alt="" width="92" height="92" />
        </div>
        <p>
          Our primary focus is on offering specialised finance, which involves the provision of various forms of
          short-term bridging finance, for both businesses and individuals, which is not typically provided by the
          major banks and financial institutions. The products we provide are typically outside of traditional
          financial offerings; however we operate to the highest level of integrity, ethics and corporate governance.
        </p>
        <a class="btn btn-brand btn-sm" href="/about/">Learn more</a>
      </div>
    </div>
  </section>

  <!-- Testimonials -->
  {showTestimonials && (
    <section class="testimonials" aria-label="Client testimonials">
      <div class="container">
        <div class="testimonial-grid">
          {testimonials.map((t, i) => (
            <div class="testimonial" data-reveal style={`--reveal-delay:${(i % 2) * 120}ms`}>
              <p class="testimonial-quote">{t.quote}</p>
              <div class="testimonial-name">{t.name}</div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- What we focus on -->
  <section class="focus">
    <div class="container">
      <div data-reveal>
        <p class="eyebrow">We provide EASY, EFFICIENT, FAST bridging finance solutions for</p>
        <h2>What we focus on:</h2>
        <hr class="divider" />
      </div>
      <div class="focus-grid">
        <div>
          {focus.slice(0, 2).map((p, i) => (
            <div class="focus-item" data-reveal style={`--reveal-delay:${i * 120}ms`}>
              <h3>{p.focus!.title}</h3>
              <p>{p.focus!.text}</p>
              <a href={`/products/${p.slug}/`} class="small" style="font-weight:700">Learn more <Icon name="arrow-right" size={14} /></a>
            </div>
          ))}
        </div>
        <div class="focus-media" data-reveal="zoom">
          <img src="/images/focus.svg" alt="" />
        </div>
        {focus.slice(2).map((p, i) => (
          <div class="focus-item" data-reveal style={`--reveal-delay:${i * 120}ms`}>
            <h3>{p.focus!.title}</h3>
            <p>{p.focus!.text}</p>
            <a href={`/products/${p.slug}/`} class="small" style="font-weight:700">Learn more <Icon name="arrow-right" size={14} /></a>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

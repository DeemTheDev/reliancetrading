---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page not found" showPopup={false} noindex>
  <section class="section text-center" style="padding:140px 0">
    <div class="container">
      <p class="eyebrow">Error 404</p>
      <h1 style="font-size:clamp(34px,5vw,60px)">Page not found</h1>
      <p style="max-width:520px;margin:0 auto 30px">The page you are looking for has moved or no longer exists.</p>
      <a class="btn btn-brand" href="/">Back to the home page</a>
    </div>
  </section>
</BaseLayout>
